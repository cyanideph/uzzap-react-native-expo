{
  "name": "uzzap-react-native-expo",
  "version": "0.1.0",
  "private": true,
  "description": "Uzzap (JavaUzzap) — React Native / Expo client. Foundation project.",
  "author": "uzzap-clone",
  "license": "UNLICENSED",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx --cache --cache-location .eslintcache",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix --cache --cache-location .eslintcache",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\" --cache --cache-location .prettiercache",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\" --cache --cache-location .prettiercache",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:up": "drizzle-kit up",
    "prepare": "husky"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/stack": "^7.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.38.3",
    "expo": "~52.0.28",
    "expo-application": "~6.0.1",
    "expo-asset": "~11.0.5",
    "expo-av": "~15.0.2",
    "expo-build-properties": "~0.13.3",
    "expo-constants": "~17.0.3",
    "expo-contacts": "~14.0.5",
    "expo-crypto": "~14.0.2",
    "expo-device": "~7.0.2",
    "expo-font": "~13.0.3",
    "expo-haptics": "~14.0.1",
    "expo-image": "~2.0.4",
    "expo-linking": "~7.0.4",
    "expo-local-authentication": "~15.0.2",
    "expo-notifications": "~0.29.11",
    "expo-router": "~4.0.17",
    "expo-secure-store": "~14.0.1",
    "expo-sms": "~13.0.1",
    "expo-splash-screen": "~0.29.20",
    "expo-sqlite": "~15.0.3",
    "expo-status-bar": "~2.0.1",
    "expo-system-ui": "~4.0.7",
    "expo-task-manager": "~12.0.3",
    "immer": "^10.1.1",
    "long": "^5.2.3",
    "protobufjs": "^7.4.0",
    "query-string": "^7.1.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "^7.54.2",
    "react-native": "0.76.6",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-mmkv": "^2.12.2",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-tcp-socket": "^6.2.0",
    "react-native-web": "~0.19.13",
    "uuid": "^11.0.3",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~18.3.12",
    "@types/uuid": "^10.0.0",
    "babel-plugin-inline-import": "^3.0.0",
    "drizzle-kit": "^0.30.1",
    "eslint": "^8.57.1",
    "eslint-config-expo": "~8.0.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-drizzle": "^0.2.3",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2",
    "typescript": "~5.3.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=18"
  }
}
