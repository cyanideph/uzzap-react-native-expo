{
  "expo": {
    "name": "Uzzap",
    "slug": "uzzap",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "uzzap",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "primaryColor": "#FF7A1A",
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "com.kolipri.uzzap",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#14161A"
      },
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_DATA_SYNC",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.READ_SMS",
        "android.permission.RECEIVE_SMS",
        "android.permission.BIND_SMS_SERVICE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
      ]
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kolipri.uzzap",
      "infoPlist": {
        "NSContactsUsageDescription": "Uzzap uses your contacts to help you find and invite buddies.",
        "NSFaceIDUsageDescription": "Uzzap can use Face ID to unlock the app."
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#14161A",
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0F1115"
          }
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow Uzzap to use Face ID to unlock the app."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Uzzap to use Face ID to unlock the app."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#FF7A1A",
          "sounds": ["./assets/sounds/alert.wav"]
        }
      ],
      "expo-sqlite",
      "expo-contacts",
      "expo-av",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "minSdkVersion": 24,
            "compileSdkVersion": 34,
            "targetSdkVersion": 34,
            "packagingOptions": {
              "pickFirst": ["**/libc++_shared.so", "**/libreactnativejni.so"]
            }
          }
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "00000000-0000-0000-0000-000000000000"
      }
    }
  }
}
